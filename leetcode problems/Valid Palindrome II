class Solution {
    public boolean validPalindrome(String s) {
        int left=0;
        int count=0;
        int right=s.length()-1;
        while(left<right){
            if(s.charAt(left)==s.charAt(right)){
                left++;
                right--;
            }else{
                if(count==1){
                    return false;
                }
                count++;
                if(check(s,left+1,right)){
                    left++;
                    
                }else if(check(s,left,right-1)){
                    right--;
                }else{
                   return false;
                }
                    
                }
                
            }
            return true;
           
        }
        public boolean check(String s,int left,int right){
            while(left<right){
            if(s.charAt(left)!=s.charAt(right)){
                return false;
            }
            left++;
            right--;
        }
        return true;
        }
        
        
    }
